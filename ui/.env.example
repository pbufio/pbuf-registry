# API Configuration
# Base URL for the pbuf registry API (default: /api)
# The frontend will make requests to this endpoint, which should be proxied to pbuf.cloud

# Development: Used by Vite dev server proxy
# Production: Used by nginx proxy in Docker container
API_BASE_URL=http://localhost:8080

# API Authentication (Server-side only)
# This token is used by the Vite dev server proxy (development) and nginx proxy (production)
# to authenticate with the backend API
# It is NOT exposed to the frontend/browser
API_TOKEN=dev-admin-token

# Public mode
# If set, the UI can be used without a server-side API token (anonymous browsing),
# and users may optionally login by providing a token in the UI.
PUBLIC_ENABLED=true

# Production Docker Container Usage:
# docker run -p 8080:80 \
#   -e API_BASE_URL=http://pbuf.cloud \
#   -e API_TOKEN=your_raw_token \
#   -e PUBLIC_ENABLED=true \
#   your-image-name